<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FlaxMcp</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <PackageType>McpServer;DotnetTool</PackageType>
    <ToolCommandName>flax-mcp-live</ToolCommandName>
    <PackageId>FlaxMcp-Live</PackageId>
    <VersionPrefix>0.2.0</VersionPrefix>
    <VersionSuffix>preview.3</VersionSuffix>
    <Description>MCP server for Flax Engine projects with a live editor bridge: unattended compile, play and test loops.</Description>
    <PackageTags>mcp;mcp-server;flax;flax-engine;game-development;live-editor</PackageTags>
    <RepositoryUrl>https://github.com/meet-brad-ch/FlaxMCP-Live</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FlaxMcp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include=".mcp\server.json" Pack="true" PackagePath=".mcp/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="ModelContextProtocol" Version="2.3.0" />
  </ItemGroup>

</Project>
